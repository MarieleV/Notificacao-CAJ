# Copie este arquivo para .env e preencha os valores.
PORT=3000

# Segredo para assinar os tokens JWT (mínimo 32 caracteres, aleatório).
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-ou-mais-caracteres

# Tempo de validade do token (ex.: 8h, 1d, 30m)
JWT_EXPIRES_IN=8h

# Conexão com o Postgres do Supabase.
# Supabase > Project Settings > Database > Connection string > "Transaction pooler" (porta 6543)
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Chave mestra que cifra (AES-256-GCM) a chave do Gemini de cada usuário no banco.
# 64 caracteres hexadecimais. Gere uma com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Se ela for trocada, as chaves já salvas deixam de ser lidas e cada usuário precisa cadastrar a sua de novo.
ENCRYPTION_KEY=troque-por-64-caracteres-hexadecimais

# Origens que podem chamar a API pelo navegador (URLs separadas por vírgula, sem barra no final).
# Se ficar vazio, valem o front-end publicado e o ambiente local:
# https://notificacao-caj-7ncb.vercel.app,http://localhost:5173
CORS_ORIGINS=
