# Copie este arquivo para .env e preencha os valores.
PORT=3000

# Segredo para assinar os tokens JWT (mínimo 32 caracteres, aleatório).
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-ou-mais-caracteres

# Tempo de validade do token (ex.: 8h, 1d, 30m)
JWT_EXPIRES_IN=8h

# Usuários autorizados (JSON em uma única linha). Gere o hash com: npm run hash -- "senha"
AUTH_USERS=[{"usuario":"admin","nome":"Administrador","senhaHash":"$2b$10$COLE_AQUI_O_HASH"}]
